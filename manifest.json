{
  "manifest_version": 2,
  "name": "Lolz Publication Helper",
  "version": "1.1",
  "description": "Проверка права публикации тем на форумах lolz.team и zelenka.guru",
  "content_scripts": [
    {
      "matches": [
        "https://lolz.team/threads/*",
        "https://zelenka.guru/threads/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
